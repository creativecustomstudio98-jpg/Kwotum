{
  "name": "wyceno",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <27",
    "pnpm": "11.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf .turbo",
    "dev": "turbo run dev",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots=all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "turbo": "2.10.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
