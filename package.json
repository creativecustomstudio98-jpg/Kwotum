{
  "name": "wyceno",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <27",
    "pnpm": "11.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf .turbo",
    "dev": "turbo run dev",
    "e2e": "playwright test",
    "e2e:panel": "pnpm --filter @wyceno/web e2e:panel",
    "e2e:update": "playwright test --update-snapshots=all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "security:dependencies": "bash scripts/security/dependency-scan.sh",
    "security:sast": "bash scripts/security/static-scan.sh",
    "security:semgrep": "bash scripts/security/semgrep-scan.sh",
    "security:secrets": "bash scripts/security/secret-scan.sh",
    "security:scan": "pnpm security:sast && pnpm security:secrets",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "start": "turbo run start",
    "test": "pnpm test:unit && pnpm test:rls && pnpm test:wordpress",
    "test:rls": "bash scripts/test-rls.sh",
    "test:unit": "turbo run test",
    "test:wordpress": "bash apps/wordpress-plugin/tests/run.sh",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
